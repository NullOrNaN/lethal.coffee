/**
 * ResponsiveImage component that delivers WebP images with multi-size srcset support.
 * Optimizes bandwidth by serving appropriately-sized images based on viewport.
 */
interface Props {
  base: string;
  alt: string;
  widths: number[];
  sizes: string;
  className?: string;
  width: number;
  height: number;
  loading?: "lazy" | "eager";
}

const {
  base,
  alt,
  widths,
  sizes,
  className,
  width,
  height,
  loading = "lazy"
} = Astro.props;

const defaultWidth = widths[widths.length - 1];
const src = `${base}-${defaultWidth}.webp`;
const srcset = widths.map((w) => `${base}-${w}.webp ${w}w`).join(", ");
---

<picture>
  <source type="image/webp" srcset={srcset} sizes={sizes} />
  <img
    class={className}
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
  />
</picture>
