---
import SeoHead from "../components/SeoHead.astro";
const pageTitle = "Matt McGowan · About";
const pageDescription =
  "Principal Engineer and Technology Executive focused on software engineering and SaaS, with deep experience in infrastructure, platform engineering, and SRE.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={pageTitle} description={pageDescription} canonical="https://lethal.coffee/about" type="article" />
    <link rel="stylesheet" href="/assets/styles/main.css" />
  </head>
  <body>
    <header class="site-header page-shell">
      <div class="topbar">
        <a class="brand" href="/" aria-label="MattMcG / Lethal Coffee home">MattMcG / Lethal Coffee</a>
        <nav class="top-links" aria-label="Primary">
          <a href="/projects">Projects</a>
          <a href="/#ventures">Ventures</a>
          <a href="/connect">Connect</a>
        </nav>
      </div>
    </header>

    <main class="page-shell">
      <article class="about-wrap">
        <header class="about-header">
          <p class="eyebrow">Matt McGowan</p>
          <h1 class="about-title">Principal Engineer. Technology Executive. Builder.</h1>
        </header>

        <div class="about-body">
          <p>
            I have been building software and systems since 2005. Today my focus is software engineering and SaaS: shaping architecture, building products, and leading teams from idea to production. I bring the infrastructure depth to support that work, spanning SRE, InfraOps, platform engineering, GitOps, AIOps, and production operations. My work connects hands-on engineering with executive execution, from the architecture decision to the 2am incident call.
          </p>
          <p>
            I am the Founding Chief Technology Officer at OUR+'R Technologies and run NullOrNaN Systems, where I personally deliver software engineering, SaaS architecture, fractional CTO, vCIO, vCOO, Principal SRE, and scoped technical project engagements. I am also Lead Engineer at Reliability Lounge, a community and content hub for operators who work in production environments. Before that, I spent years at ASRC Federal leading infrastructure modernization across large, complex systems, cutting incident resolution time, improving platform stability, and building the kind of cross-functional operational discipline that doesn't get taught in a course.
          </p>
          <p>
            I am available for the right full-time, contract, or part-time opportunity, targeting Director through CXO scope. NullOrNaN is a home for consulting, scoped projects, and fractional leadership; it is not designed to replace full-time employment. Fit and organizational impact matter more to me than the exact title.
          </p>

          <p class="about-routing">
            For consulting and project work, start at <a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">nullornan.com</a>.
            For full-time opportunities or a direct connection, find me on <a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
          </p>
        </div>
      </article>
    </main>

    <footer class="site-footer page-shell">
      <div class="footer-inner">
        <p class="footer-name">Matt McGowan</p>
        <nav class="footer-links" aria-label="External links">
          <a href="https://lethal.coffee" target="_blank" rel="noopener noreferrer">lethal.coffee</a>
          <a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">nullornan.com</a>
          <a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://reliabilitylounge.com" target="_blank" rel="noopener noreferrer">reliabilitylounge.com</a>
          <a href="https://github.com/NullOrNaN" target="_blank" rel="noopener noreferrer">github.com/NullOrNaN</a>
          <a href="https://app.reclaim.ai/m/nan-connects" target="_blank" rel="noopener noreferrer">Book a Call</a>
        </nav>
        <p class="footer-copy">&copy; 2026 Matt McGowan</p>
      </div>
    </footer>

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c1bd1d7c50244959b719cc3bbf367dbd"}'></script>
  </body>
</html>
