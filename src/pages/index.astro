---
import ResponsiveImage from "../components/ResponsiveImage.astro";
import SeoHead from "../components/SeoHead.astro";
import { projects } from "../data/projects";

const ventures = [
  { name: "OUR+'R Technologies", role: "Co-Founder, Chief Technology Officer", body: "Building the next layer of infrastructure for operator-led businesses.", url: "https://getride.plus", image: "ourr.png" },
  { name: "NullOrNaN Systems", role: "Chief Technology Officer", body: "Principal-led, high-touch technical leadership for teams navigating consequential change.", url: "https://nullornan.com", image: "nullornan.png" },
  { name: "Reliability Lounge", role: "Founder & Operator", body: "Operator content, reliability writing, and community for people who lead production systems.", url: "https://reliabilitylounge.com", image: "rl.png" }
];

const faqs = [
  { question: "Who is Matt McGowan?", answer: "Matt McGowan is a Principal Engineer and Technology Executive with a multi-disciplinary background spanning software engineering, SRE, InfraOps, and platform engineering. He has been building software and systems since 2005, with deep experience in GitOps, AIOps, reliability, and operating production environments." },
  { question: "What executive problems does Matt help solve?", answer: "He helps executive teams turn infrastructure risk into operating leverage through software engineering leadership, SRE and InfraOps, platform strategy, GitOps, AIOps, reliability programs, incident leadership, and technical modernization." },
  { question: "How can recruiters, founders, and executive teams engage Matt?", answer: "Recruiters should connect with Matt on LinkedIn. Teams, executives, and founders should start with NullOrNaN. For a direct connection, send a free LinkedIn InMail with your pitch." }
];
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><SeoHead title="Matt McGowan · Infrastructure & Platform Leader" description="Matt McGowan builds resilient systems, leads operational change, and runs ventures at the edge of infrastructure and organizational leadership." canonical="https://lethal.coffee/" faqs={faqs} /><link rel="stylesheet" href="/assets/styles/main.css" /></head>
<body><div class="site-atmosphere" aria-hidden="true"><span></span><span></span><span></span></div><header class="site-header page-shell"><div class="topbar"><a class="brand" href="/" aria-label="MattMcG / Lethal Coffee home">MattMcG / Lethal Coffee</a><nav class="top-links" aria-label="Primary"><a href="/about">About</a><a href="/projects">Projects</a><a href="#ventures">Ventures</a><a href="/connect">Connect</a></nav></div></header>
<nav class="section-nav" aria-label="Section navigation"><div class="section-nav-controls"><button type="button" data-section-prev aria-label="Previous section" disabled>↑</button><button type="button" data-section-next aria-label="Next section">↓</button></div><span class="section-nav-label" id="section-label">Intro</span><p class="sr-only" id="section-status" aria-live="polite">Current section: Intro. Use the up and down arrow keys to navigate.</p></nav>
<main><section id="intro" data-section="Intro" class="landing page-shell" aria-labelledby="hero-title"><div class="hero-grid"><div class="hero-copy"><p class="eyebrow">Matt McGowan · Principal Engineer / Technology Executive</p><h1 id="hero-title">I build systems that keep their nerve.</h1><p class="hero-body">Principal Engineer and Technology Executive helping founders, recruiters, and leadership teams turn technical complexity into reliable operating leverage.</p><p class="hero-note"><strong>lethal.coffee</strong> is the nickname that stuck. I take the work seriously, not myself.</p><div class="hero-actions"><a class="button button-primary" href="/projects">Explore selected work <span aria-hidden="true">↓</span></a><a class="text-link" href="/connect">Discuss an opportunity <span aria-hidden="true">↗</span></a></div></div><div class="hero-portrait-wrap"><div class="portrait-orbit orbit-one" aria-hidden="true"></div><div class="portrait-orbit orbit-two" aria-hidden="true"></div><ResponsiveImage class="hero-profile" base="/assets/images/profile2/profile2" widths={[160, 200, 320, 400]} sizes="(max-width: 700px) 210px, 320px" alt="Matt McGowan, Principal Engineer and Technology Executive" width={320} height={320} loading="eager" /><p class="portrait-caption">Don't Build Stupid. You'll find out in production.</p></div></div><a class="scroll-prompt" href="#work">Scroll to inspect <span aria-hidden="true">↓</span></a></section>
<section id="work" data-section="Selected work" class="work-reel page-shell" aria-labelledby="work-title"><div class="section-heading split-heading"><div><p class="section-kicker">Selected work</p><h2 id="work-title">Measured in outcomes,<br />not noise.</h2></div><p>Four operating environments where the work was as much about clarity and trust as it was about technology.</p></div><div class="work-stack">{projects.map((project) => <a class="work-card" href={`/projects/${project.slug}`}><span class="project-number">{project.number}</span><div><p>{project.eyebrow}</p><h3>{project.title}</h3></div><strong>{project.outcome}</strong><span class="card-arrow" aria-hidden="true">↗</span></a>)}</div><div class="leadership-snapshot" aria-label="Leadership experience"><div><strong>12+</strong><span>teams led across companies</span></div><div><strong>~25</strong><span>engineers on largest team</span></div><div><strong>150</strong><span>engineers under responsibility at peak</span></div></div></section>
<section id="ventures" data-section="Ventures" class="ventures-band" aria-labelledby="ventures-title"><div class="page-shell"><div class="section-heading split-heading"><div><p class="section-kicker">In motion</p><h2 id="ventures-title">Three properties.<br />Distinct jobs.</h2></div><p>Venture building, advisory work, and a home for the people who run production systems.</p></div><div class="venture-grid">{ventures.map((venture) => <a class="venture-card" href={venture.url} target="_blank" rel="noopener noreferrer"><div class="venture-brand"><img src={`/assets/images/${venture.image}`} alt="" aria-hidden="true" /><span>{venture.role}</span></div><h3>{venture.name}</h3><p>{venture.body}</p><span class="text-link">Visit <span aria-hidden="true">↗</span></span></a>)}</div></div></section>
<section id="answers" data-section="Quick answers" class="faq-band page-shell" aria-labelledby="faq-title"><p class="section-kicker">For recruiters, founders, and executives</p><h2 id="faq-title">The short version.</h2><div class="faq-list">{faqs.map((faq, index) => <details><summary>{faq.question}</summary>{index === 2 ? <p>Recruiters should connect with Matt on <a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a>. Teams, executives, and founders should start with <a href="https://nullornan.com" target="_blank" rel="noopener noreferrer">NullOrNaN</a>. For a direct connection, send a free LinkedIn InMail with your pitch.</p> : <p>{faq.answer}</p>}</details>)}</div></section>
<section id="contact" data-section="Contact" class="closing page-shell" aria-labelledby="closing-title"><p class="section-kicker">Executive technical leadership</p><h2 id="closing-title">Need ownership for a hard technical problem?</h2><p>I partner with leadership teams when infrastructure, platform strategy, or operational change needs a principal-level owner.</p><a class="button button-primary" href="/connect">Start the conversation <span aria-hidden="true">→</span></a></section></main>
<footer class="site-footer page-shell"><p>Matt McGowan · 2026</p><div><a href="https://www.linkedin.com/in/matthewcmcgowan" target="_blank" rel="noopener noreferrer">LinkedIn</a><a href="https://github.com/NullOrNaN" target="_blank" rel="noopener noreferrer">GitHub</a><a href="https://reliabilitylounge.com" target="_blank" rel="noopener noreferrer">Reliability Lounge</a></div></footer>
<script>
  const sections = [...document.querySelectorAll("[data-section]")];
  const previous = document.querySelector("[data-section-prev]");
  const next = document.querySelector("[data-section-next]");
  const label = document.querySelector("#section-label");
  const status = document.querySelector("#section-status");
  let currentIndex = 0;

  const setCurrentSection = (index, announce = false) => {
    currentIndex = Math.max(0, Math.min(index, sections.length - 1));
    label.textContent = sections[currentIndex].dataset.section;
    previous.disabled = currentIndex === 0;
    next.disabled = currentIndex === sections.length - 1;
    if (announce) status.textContent = `Current section: ${sections[currentIndex].dataset.section}.`;
  };

  const goToSection = (index) => {
    setCurrentSection(index, true);
    sections[currentIndex].scrollIntoView({ behavior: "smooth", block: "start" });
  };

  previous.addEventListener("click", () => goToSection(currentIndex - 1));
  next.addEventListener("click", () => goToSection(currentIndex + 1));
  new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) setCurrentSection(sections.indexOf(entry.target));
    });
  }, { rootMargin: "-35% 0px -55%", threshold: 0 }).observe(sections[0]);
  sections.slice(1).forEach((section) => new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) setCurrentSection(sections.indexOf(section));
  }, { rootMargin: "-35% 0px -55%", threshold: 0 }).observe(section));

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    if (target instanceof HTMLElement && (target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT", "BUTTON", "A"].includes(target.tagName))) return;
    if (["ArrowDown", "PageDown"].includes(event.key)) { event.preventDefault(); goToSection(currentIndex + 1); }
    if (["ArrowUp", "PageUp"].includes(event.key)) { event.preventDefault(); goToSection(currentIndex - 1); }
    if (event.key === "Home") { event.preventDefault(); goToSection(0); }
    if (event.key === "End") { event.preventDefault(); goToSection(sections.length - 1); }
  });
</script></body></html>
