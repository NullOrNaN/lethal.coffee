---
const pageTitle = "Matt McGowan";
const pageDescription =
  "Co-Founder, CTO & COO. Infrastructure and platform leader. Identity hub — find the right lane.";

const vehicles = [
  {
    name: "OUR+'R Technologies",
    role: "Co-Founder & CTO",
    body: "Building the next layer of infrastructure for operator-led businesses.",
    icon: "ourr"
  },
  {
    name: "NullOrNaN Systems",
    role: "Founder & Principal",
    body: "Fractional CTO/COO and boutique advisory. Reliability, platform engineering, and operational leadership for teams that need it done right.",
    url: "https://nullornan.com",
    icon: "nullornan"
  },
  {
    name: "Reliability Lounge",
    role: "Founder & Operator",
    body: "Operator content, reliability writing, and community for people who actually run systems in production.",
    url: "https://reliabilitylounge.com",
    icon: "reliability"
  }
];

const routes = [
  {
    intent: "Work with me",
    sub: "Fractional / advisory engagements",
    url: "https://nullornan.com",
    cta: "nullornan.com",
    arrow: true
  },
  {
    intent: "Connect or network",
    sub: "Professional conversations, connections",
    url: "https://www.linkedin.com/in/matthewcmcgowan",
    cta: "linkedin.com/in/matthewcmcgowan",
    arrow: true
  },
  {
    intent: "Talk about my ventures",
    sub: "OUR+'R, NullOrNaN, Reliability Lounge",
    url: "https://app.reclaim.ai/m/nan-connects",
    cta: "NaN Connects — Book time",
    arrow: true
  },
  {
    intent: "Read operator content",
    sub: "Reliability writing and community",
    url: "https://reliabilitylounge.com",
    cta: "reliabilitylounge.com",
    arrow: true
  },
  {
    intent: "See my code",
    sub: "Public repos and technical artifacts",
    url: "https://github.com/NullOrNaN",
    cta: "github.com/NullOrNaN",
    arrow: true
  }
];

const metrics = [
  {
    metric: "$2M+",
    label: "AI spend governed",
    meta: "Q4 2025 · $8M annualized",
    body: "Built governance, centralized controls, and automation for AI workloads."
  },
  {
    metric: "~50%",
    label: "Downtime reduction",
    meta: "Q2 2025",
    body: "Cloud transformation using elastic, immutable Kubernetes infrastructure patterns."
  },
  {
    metric: "4×",
    label: "Incident resolution",
    meta: "Q2 2024",
    body: "Led cross-functional incident command across infrastructure, database, security, and cloud."
  },
  {
    metric: "~3×",
    label: "Uptime improvement",
    meta: "Q1 2023",
    body: "Platform stability across 120+ systems through automation and configuration standardization."
  }
];

const footerLinks = [
  { label: "lethal.coffee", url: "https://lethal.coffee" },
  { label: "nullornan.com", url: "https://nullornan.com" },
  { label: "LinkedIn", url: "https://www.linkedin.com/in/matthewcmcgowan" },
  { label: "reliabilitylounge.com", url: "https://reliabilitylounge.com" },
  { label: "github.com/NullOrNaN", url: "https://github.com/NullOrNaN" },
  { label: "Book a Call", url: "https://app.reclaim.ai/m/nan-connects" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0a0f14" />
    <link rel="canonical" href="https://lethal.coffee/" />
    <link rel="stylesheet" href="/assets/styles/main.css" />
  </head>
  <body>
    <header class="site-header page-shell">
      <div class="topbar">
        <a class="brand" href="/">lethal.coffee</a>
        <nav class="top-links" aria-label="Primary">
          <a href="/about">About</a>
          <a href="#ventures">Ventures</a>
          <a href="#where-to-go">Where to Go</a>
          <a href="#proof">Proof Points</a>
          <a href="/connect">Connect</a>
        </nav>
      </div>
    </header>

    <main class="page-shell">

      <!-- HERO -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Matt McGowan</p>
          <h2 id="hero-title">Co-Founder, CTO &amp; COO · Infrastructure &amp; Platform Leader.</h2>
          <p class="hero-body">
            I build and operate production infrastructure, lead incident response, and run ventures at the intersection of systems engineering and organizational leadership.
          </p>
          <p class="lethal-note">
            <span class="lethal-label">lethal.coffee</span> — a nickname that stuck. High-octane, occasionally dangerous, best consumed black. This site is the starting point. Find the right lane below.
          </p>
        </div>
        <div class="hero-media">
          <img
            class="hero-profile"
            src="/assets/images/matt.webp"
            alt="Matt McGowan"
            loading="eager"
            width="200"
            height="200"
          />
        </div>
      </section>

      <!-- ACTIVE VENTURES -->
      <section id="ventures" aria-labelledby="ventures-title">
        <div class="section-heading">
          <h2 id="ventures-title">Active ventures.</h2>
          <p>Three properties. Each has one job.</p>
        </div>
        <div class="grid grid-three">
          {vehicles.map((v) => (
            <article class={`card vehicle-card${v.url ? "" : " no-link"}`}>
              <div class="vehicle-brand">
                {v.icon === "ourr" && (
                  <img class="vehicle-logo" src="/assets/images/ourr.png" alt="" aria-hidden="true" />
                )}
                {v.icon === "nullornan" && (
                  <img class="vehicle-logo" src="/assets/images/nullornan.png" alt="" aria-hidden="true" />
                )}
                {v.icon === "reliability" && (
                  <img class="vehicle-logo" src="/assets/images/rl.png" alt="" aria-hidden="true" />
                )}
                <div>
                  <h3>{v.name}</h3>
                  <p class="vehicle-role">{v.role}</p>
                </div>
              </div>
              <p>{v.body}</p>
              {v.url && (
                <a class="card-link" href={v.url} target="_blank" rel="noopener noreferrer">Visit →</a>
              )}
            </article>
          ))}
        </div>
      </section>

      <!-- ROUTING -->
      <section id="where-to-go" aria-labelledby="routing-title">
        <div class="section-heading">
          <h2 id="routing-title">Follow the lane that matches your intent.</h2>
        </div>
        <div class="route-list">
          {routes.map((r) => (
            <a class="route-row" href={r.url} target="_blank" rel="noopener noreferrer">
              <div class="route-intent">
                <span class="route-primary">{r.intent}</span>
                <span class="route-sub">{r.sub}</span>
              </div>
              <span class="route-cta">{r.cta} →</span>
            </a>
          ))}
        </div>
      </section>

      <!-- PROOF POINTS -->
      <section id="proof" aria-labelledby="proof-title">
        <div class="section-heading">
          <h2 id="proof-title">Proof points from real operating environments.</h2>
        </div>
        <div class="proof-grid">
          {metrics.map((m) => (
            <article class="proof-card">
              <div class="proof-metric">{m.metric}</div>
              <h3 class="proof-label">{m.label}</h3>
              <p class="proof-meta">{m.meta}</p>
              <p class="proof-body">{m.body}</p>
            </article>
          ))}
        </div>
      </section>

    </main>

    <footer class="site-footer page-shell">
      <div class="footer-inner">
        <p class="footer-name">Matt McGowan</p>
        <nav class="footer-links" aria-label="External links">
          {footerLinks.map((l) => (
            <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
          ))}
        </nav>
        <p class="footer-copy">&copy; 2026 Matt McGowan</p>
      </div>
    </footer>

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c1bd1d7c50244959b719cc3bbf367dbd"}'></script>
  </body>
</html>
